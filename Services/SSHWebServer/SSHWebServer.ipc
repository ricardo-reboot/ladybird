#include <LibIPC/TransportHandle.h>
#include <LibURL/URL.h>

endpoint SSHWebServer
{
    // Standard handshake messages every Ladybird helper service implements.
    init_transport(int peer_pid) => (int peer_pid)
    connect_new_client() => (IPC::TransportHandle handle)

    // Issue a command against an ssh-web:// origin (e.g. "capabilities").
    start_request(u64 request_id, URL::URL url, ByteString command) =|

    // Cancel an in-flight request.
    stop_request(u64 request_id) => (bool success)

    // Response to a TOFU prompt previously sent via tofu_prompt.
    tofu_decision(u64 prompt_id, bool accepted) =|
}
