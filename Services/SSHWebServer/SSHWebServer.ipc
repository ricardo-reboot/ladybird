#include <LibIPC/TransportHandle.h>
#include <LibURL/URL.h>

endpoint SSHWebServer
{
    // Standard handshake messages every Ladybird helper service implements.
    init_transport(int peer_pid) => (int peer_pid)
    connect_new_client() => (IPC::TransportHandle handle)

    // Issue a command against an ssh-web:// origin (e.g. "capabilities").
    // identity_id/identity_dir/passphrase are empty for anonymous mode.
    start_request(u64 request_id, URL::URL url, ByteString command, ByteString identity_id, ByteString identity_dir, ByteString passphrase) =|

    // Cancel an in-flight request.
    stop_request(u64 request_id) => (bool success)

    // Drop all pooled SSH connections so the next request re-authenticates.
    clear_ssh_pool() =|

    // Response to a TOFU prompt previously sent via tofu_prompt.
    // accepted: whether the user chose to trust the host key.
    // permanent: if true, persist the key to known_hosts; if false, trust for this session only.
    tofu_decision(u64 prompt_id, bool accepted, bool permanent) =|
}
